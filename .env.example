# Copy this file to .env.local (already git-ignored) and fill in the values.
# Vite loads .env.local automatically during `npm run dev` / `npm run build`.

# Google OAuth Client ID — required for the "Sign in with Google" button.
# Create one at https://console.cloud.google.com/apis/credentials
# (Application type: Web application → add your dev/prod origins as
#  "Authorized JavaScript origins", e.g. http://localhost:5173)
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Supabase — optional overrides (defaults to the project's Supabase below)
